PROJECT_NAME="MM3 Música - ERP Banda & Assessoria Musical de Casamentos"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Banco de Dados Principal (PostgreSQL 15 via Docker Compose)
POSTGRES_USER=mm3_admin
POSTGRES_PASSWORD=mm3_secret_2026
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=mm3_musica_db
DATABASE_URL=postgresql+psycopg2://mm3_admin:mm3_secret_2026@localhost:5432/mm3_musica_db

# Habilita fallback automático para SQLite local caso o container Docker PostgreSQL não esteja ativo no host
ENABLE_SQLITE_FALLBACK=true
SQLITE_FALLBACK_URL=sqlite:///./mm3_musica.db

# Segurança JWT
SECRET_KEY=troque-por-uma-chave-aleatoria-longa
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]
